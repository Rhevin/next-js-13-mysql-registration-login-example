# PocketBase (server-side admin API for user CRUD)
POCKETBASE_URL=https://your-instance.example/_pb
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=replace-me

# JWT (API session tokens for the Next.js UI)
JWT_SECRET=replace-with-a-strong-random-secret

# API (public — accessible in the browser)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
